# ASTRA Bybit product runtime
# Copy values into your deployment secret/config system. Do not commit real credentials.

ASTRA_ENV=demo
ASTRA_BROKER=bybit

# Demo Trading credentials created from Bybit Demo Trading mode.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# These endpoints are intentionally pinned by app/runtime/bybit_product_config.py.
BYBIT_REST_URL=https://api-demo.bybit.com
BYBIT_PRIVATE_WS_URL=wss://stream-demo.bybit.com/v5/private
BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear

# Authoritative runtime state must use PostgreSQL.
DATABASE_URL=postgresql://astra:change-me@127.0.0.1:5432/astra

# Demo order mutations remain opt-in. Mainnet is not configurable on this code path.
TRADING_WRITES_ENABLED=false
MAINNET_ENABLED=false

ASTRA_POLL_INTERVAL_MS=1000
ASTRA_SHUTDOWN_GRACE_SECONDS=15
LOG_LEVEL=INFO

# Observability endpoints remain optional until their concrete adapters are configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
