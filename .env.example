# ASTRA — local environment template.
# Copy to .env and fill in. Never commit .env: it is git-ignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DSN used by tools/bootstrap_db.py and by the runtime.
ASTRA_POSTGRES_DSN=postgresql://astra:astra@127.0.0.1:5433/astra

# DSN used by the integration suite. Without it, 27 PostgreSQL test modules skip
# and the durable OMS, reconciliation and risk-reservation layers go unverified.
ASTRA_TEST_POSTGRES_DSN=postgresql://astra:astra@127.0.0.1:5433/astra

# Fleet-deployment integration tests (v105/v106) need a database of their own.
# CI never runs them alongside the rest of the suite: canonical-deployment-regression
# gives them a fresh service container. Pointing them at the same database as the main
# suite lets earlier tests leave state behind that makes the v105 replay-fencing
# assertion fail, while every test still passes in isolation.
ASTRA_TEST_FLEET_DEPLOYMENT_DSN=postgresql://astra:astra@127.0.0.1:5433/astra_fleet

# Credentials the compose Postgres service is created with.
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra
POSTGRES_DB=astra
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Alpaca paper broker — read-only probes and paper mutation drills
# ---------------------------------------------------------------------------
# Paper credentials only. A live key must never be placed here.
ASTRA_ALPACA_PAPER_KEY_ID=
ASTRA_ALPACA_PAPER_SECRET_KEY=

# Order mutation against the paper broker stays off unless explicitly enabled.
ASTRA_ALPACA_PAPER_MUTATION_ENABLED=false

# ---------------------------------------------------------------------------
# Operational gates — all fail-closed by default
# ---------------------------------------------------------------------------
# Leave these false. Trading authority is granted by the release authority
# artifacts, not by an environment variable, and a green test run is not
# permission to route orders.
ASTRA_GATE_MUTATION_ENABLED=false
ASTRA_GATE_CREDENTIALS=false
ASTRA_GATE_CONFIRMATION=false
