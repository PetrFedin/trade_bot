# ASTRA Bybit product runtime
# Copy values into your deployment secret/config system. Do not commit real credentials.

ASTRA_ENV=demo
ASTRA_BROKER=bybit

# Explicit USDT-perpetual universe. No hidden production default is applied.
# Example: ASTRA_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
ASTRA_SYMBOLS=
ASTRA_BAR_INTERVAL=5
ASTRA_BAR_LOOKBACK=200

# Demo Trading credentials created from Bybit Demo Trading mode.
# These credentials are the only credentials consumed by the order-writing product runtime.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional real-account observability credentials.
# MUST be a separate Bybit mainnet API key configured read-only and bound to server IP(s).
# The mainnet read-only adapter has no POST/order mutation surface and never consumes BYBIT_API_KEY.
BYBIT_MAINNET_READONLY_API_KEY=
BYBIT_MAINNET_READONLY_API_SECRET=
# Closed audited regional profile, not a URL. Examples: global, nl, eu, ae, tr, kz, georgia, id, jp, hk.
# Use the profile matching the Bybit site/account on which the API key was created.
BYBIT_MAINNET_READONLY_SITE=global

# These endpoints are intentionally pinned by app/runtime/bybit_product_config.py.
BYBIT_REST_URL=https://api-demo.bybit.com
BYBIT_PRIVATE_WS_URL=wss://stream-demo.bybit.com/v5/private
BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear

# Authoritative runtime state must use PostgreSQL.
DATABASE_URL=postgresql://astra:change-me@127.0.0.1:5432/astra

# Demo order mutations remain opt-in. Mainnet is not configurable on this code path.
TRADING_WRITES_ENABLED=false
MAINNET_ENABLED=false

ASTRA_POLL_INTERVAL_MS=1000
ASTRA_SHUTDOWN_GRACE_SECONDS=15
LOG_LEVEL=INFO

# Observability endpoints remain optional until their concrete adapters are configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=