{
  "schema_version": "cross-sectional-trading-quality-shadow-v2",
  "shadow_only": true,
  "strategy_promotion_allowed": false,
  "minimum_symbols": 3,
  "opening_cash": "10000",
  "fee_per_fill": "0.50",
  "slippage_bps": "5",
  "selection": {
    "top_k": 2,
    "quality": {
      "momentum_weight": "1",
      "trend_weight": "1",
      "volatility_penalty_weight": "1"
    },
    "signal": {
      "fast_bars": 3,
      "slow_bars": 8,
      "momentum_lookback_bars": 3,
      "volatility_bars": 5,
      "minimum_momentum_return": "0.002",
      "minimum_trend_strength": "0.001",
      "maximum_realized_volatility": "0.03"
    }
  },
  "portfolio": {
    "maximum_gross_exposure_fraction": "0.60",
    "legacy_new_position_target_equity_fraction": "0.29",
    "allow_leverage": false,
    "rebalance_existing_positions": false
  },
  "risk_aware_sizing": {
    "risk_budget_fraction": "0.005",
    "maximum_equity_fraction": "0.29",
    "target_realized_volatility": "0.015",
    "volatility_floor": "0.001"
  },
  "legacy_position_management": {
    "stop_loss_fraction": "0.02",
    "take_profit_fraction": "0.04",
    "trailing_activation_fraction": "0.02",
    "trailing_stop_fraction": "0.015",
    "maximum_holding_bars": 10
  },
  "candidate_position_management": {
    "stop_loss_fraction": "0.02",
    "take_profit_fraction": "0.04",
    "trailing_activation_fraction": "0.03",
    "trailing_stop_fraction": "0.015",
    "maximum_holding_bars": 10,
    "break_even_activation_fraction": "0.01",
    "break_even_buffer_fraction": "0.001",
    "profit_protection_activation_fraction": "0.015",
    "maximum_profit_giveback_fraction": "0.50"
  },
  "reentry_confirmation": {
    "minimum_consecutive_eligible_bars": 2,
    "initial_entry_requires_confirmation": false,
    "reset_streak_on_ineligible_signal": true,
    "apply_after_any_exit": true
  },
  "degradation_monitor": {
    "window_trades": 20,
    "minimum_observations": 10,
    "minimum_profit_factor": "1.00",
    "minimum_profit_preservation_rate": "0.50",
    "minimum_average_mfe_capture_ratio": "0.10",
    "maximum_hard_stop_fraction": "0.50",
    "maximum_consecutive_losses": 4,
    "allow_entries_when_insufficient_data": false
  },
  "walk_forward": {
    "training_bars": 60,
    "holdout_bars": 40,
    "step_bars": 40,
    "minimum_folds": 3,
    "parameter_fitting_allowed": false,
    "reset_portfolio_each_fold": true,
    "non_overlapping_holdouts": true
  },
  "shared_controls": [
    "CONFIRMED_REENTRY",
    "CONSERVATIVE_INTRABAR_PATH",
    "NO_LEVERAGE",
    "NO_EXISTING_POSITION_REBALANCING"
  ],
  "candidate_components": [
    "RISK_ADJUSTED_SELECTION_SCORE",
    "STOP_RISK_INVERSE_VOLATILITY_SIZING",
    "BREAK_EVEN_AND_PROFIT_PROTECTION"
  ],
  "ablation_variants": [
    "SELECTION_ONLY",
    "SIZING_ONLY",
    "PROTECTION_ONLY",
    "COMBINED"
  ],
  "limitations": [
    "IN_SAMPLE_ABLATION_ONLY",
    "COMPONENT_INTERACTION_EFFECTS_NOT_SEPARATED",
    "DEGRADATION_THRESHOLDS_NOT_CALIBRATED",
    "DEGRADATION_GATE_NOT_AUTO_ACTUATED",
    "NO_WALK_FORWARD_HOLDOUT_EVIDENCE",
    "IEX_SINGLE_EXCHANGE_FEED",
    "NO_EXTERNAL_PAPER_PORTFOLIO_EXECUTION",
    "NO_STRATEGY_PROFITABILITY_CLAIM"
  ],
  "promotion_blockers": [
    "SHADOW_ONLY_POLICY",
    "NO_WALK_FORWARD_HOLDOUT_EVIDENCE",
    "NO_EXTERNAL_PAPER_PORTFOLIO_EXECUTION",
    "NO_OUT_OF_SAMPLE_ABLATION_EVIDENCE",
    "DEGRADATION_THRESHOLDS_UNCALIBRATED"
